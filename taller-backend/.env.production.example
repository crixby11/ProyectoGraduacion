####################################################################
# Plantilla de entorno de PRODUCCIÓN — copiar a .env en el servidor
# y rellenar cada valor. NUNCA subir el .env real a git.
####################################################################

APP_NAME="Taller Automotriz Hermanos Juarez"
APP_ENV=production
# Generar con: php artisan key:generate --show (y pegar el resultado aquí)
APP_KEY=
# Crítico: en producción SIEMPRE en false. Con true se exponen rutas del
# servidor, código fuente y credenciales de BD en cualquier error público.
APP_DEBUG=false
APP_URL=https://tu-dominio.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Solo necesario si el frontend se sirve desde un dominio DISTINTO al backend
# (ej. frontend en Vercel/Netlify y API en otro subdominio). Si ambos están
# en el mismo dominio (recomendado, ver DEPLOY.md), se puede dejar vacío.
CORS_ALLOWED_ORIGINS=
SANCTUM_STATEFUL_DOMAINS=

# Credenciales del primer usuario administrador — las lee AdminUserSeeder.
# Definir ANTES de correr `php artisan db:seed`. Cambiar la contraseña
# desde el sistema apenas inicies sesión por primera vez.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional — solo si quieres que los recordatorios de citas se envíen
# automáticamente por WhatsApp (cron ya programado a las 10am) en vez de
# manualmente con el botón de enlace wa.me. Requiere cuenta de Twilio con
# WhatsApp habilitado.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

CACHE_DRIVER=file
FILESYSTEM_DISK=local
# database = necesita un worker corriendo (php artisan queue:work) vía
# Supervisor/systemd. Ver DEPLOY.md.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
