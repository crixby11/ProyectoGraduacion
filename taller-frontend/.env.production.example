# Plantilla de entorno de PRODUCCIÓN para el build del frontend.
# Copiar a .env.production antes de correr `npm run build`.

# Si el frontend y el backend se sirven desde el MISMO dominio (recomendado,
# ver DEPLOY.md), déjalo como ruta relativa — no hace falta tocarlo:
VITE_API_URL=/api/v1

# Si el backend vive en un dominio/subdominio DISTINTO (ej. frontend en
# Vercel/Netlify y API en api.tu-dominio.com), usar la URL completa:
# VITE_API_URL=https://api.tu-dominio.com/api/v1
